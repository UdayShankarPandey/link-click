# Link Click — Environment Configuration Example
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/linkclick
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# ImageKit Configuration (Get these from your ImageKit.io Dashboard)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# ─── Email Configuration ──────────────────────────────────────────────────────
# Option A: Gmail SMTP with App Password (RECOMMENDED — sends to any recipient)
# Steps: Google Account → Security → 2-Step Verification → App Passwords → Generate
SMTP_USER=yourname@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=Link Click <yourname@gmail.com>

# Option B: Resend API (free tier only delivers to account-owner email — sandbox)
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM=Link Click <onboarding@resend.dev>

# The URL of your frontend (used inside verification email links)
FRONTEND_URL=https://your-app.onrender.com

# Single Founder Account Configuration
FOUNDER_EMAIL=founder@example.com
